{
  "name": "islam-ayman-studio",
  "productName": "Islam Ayman Studio",
  "version": "1.7.0",
  "description": "Islam Ayman Studio: Franco names, covers, playlists, quality, tag remover and mix track ID",
  "main": "main.js",
  "author": "DJ Islam Ayman",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "38.8.4",
    "electron-builder": "25.1.8",
    "lamejs": "1.2.1"
  },
  "build": {
    "appId": "com.djislamayman.studio",
    "productName": "Islam Ayman Studio",
    "files": [
      "main.js",
      "preload.js",
      "yt-preload.js",
      "separate.js",
      "app/**",
      "build/icon.png"
    ],
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Islam Ayman Studio",
      "artifactName": "Islam-Ayman-Studio-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "artifactName": "Islam-Ayman-Studio-${version}-mac-${arch}.${ext}",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Shazam inside Islam Ayman Studio listens through the microphone to recognize songs."
      }
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models"
      }
    ]
  },
  "dependencies": {
    "onnxruntime-node": "1.22.0"
  }
}